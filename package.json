{
  "name": "omnia-tauri",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "native:build": "tauri build",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "native:lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crap": "crap-typescript --agent --threshold 8",
    "smoke": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol --locked && node scripts/native-smoke.mjs",
    "smoke:linux": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol --locked && node scripts/native-smoke-linux.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.0.1",
    "@heroui/styles": "^3.0.1",
    "@tauri-apps/api": "2.12.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "5.6.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "^0.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^8.57.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^6.4.1",
    "vitest": "5.0.5"
  }
}
